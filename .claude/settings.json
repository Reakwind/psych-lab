{
  "hooks": {
    "SessionStart": [{"matcher": "startup|resume", "hooks": [{"type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 scripts/agents.py setup && (python3 scripts/agents.py doctor --offline || true)", "timeout": 30}]}],
    "PreToolUse": [{"matcher": "Bash", "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/agent_safety.py\" claude", "timeout": 10}]}]
  },
  "permissions": {
    "allow": [
      "Bash(npm test)", "Bash(npm run check)", "Bash(npm run media:check)", "Bash(npm run doctor)",
      "Bash(npm ci --ignore-scripts)", "Bash(node --test *)", "Bash(python3 -m unittest *)",
      "Bash(python3 scripts/agents.py setup)", "Bash(python3 scripts/agents.py doctor*)",
      "Bash(python3 scripts/agents.py status)", "Bash(python3 scripts/agents.py sync)",
      "Bash(bash scripts/cloud-bootstrap.sh*)",
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git show*)",
      "Bash(git fetch origin main)", "Bash(git lfs pull*)", "Bash(git lfs ls-files*)"
    ],
    "deny": ["Read(.env)", "Read(.env.*)", "Bash(git reset *)", "Bash(git clean *)", "Bash(git rebase *)", "Bash(git push --force*)", "Bash(git push -f*)"]
  }
}
